---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import { getGame, getMap, getGuideType } from '../../../data/games';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: {
      game: guide.data.game,
      map: guide.data.map,
      slug: guide.id.split('/').pop(),
    },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const game = getGame(guide.data.game)!;
const map = getMap(guide.data.game, guide.data.map)!;
const guideType = getGuideType(guide.data.type);
const typeName = guideType?.name ?? guide.data.type;
const isUnique = guideType?.unique ?? false;
const updated = guide.data.updated.toISOString().slice(0, 10);

const submitBase = `/submit?game=${game.id}&map=${map.id}&type=${guide.data.type}`;
const changeUrl = `${submitBase}&mode=change&title=${encodeURIComponent(guide.data.title)}`;
---

<Base title={`${guide.data.title} — ${map.name}`} description={guide.data.summary}>
  <article>
    <header class={`guide-header t-${guide.data.type}`}>
      <p class="eyebrow">
        <a href="/">Archive</a> / <a href={`/${game.id}/`}>{game.shortName}</a> /
        <a href={`/${game.id}/${map.id}/`}>{map.name}</a>
      </p>
      <h1>{guide.data.title}</h1>
      <div class="guide-meta">
        <span class={`type-chip t-${guide.data.type}`}>{typeName}</span>
        <span>by {guide.data.author}</span>
        <span>updated {updated}</span>
        {guide.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
      {
        guide.data.credit && (
          <p class="guide-credit">
            Strategy by{' '}
            {guide.data.credit.url ? (
              <a href={guide.data.credit.url} target="_blank" rel="noopener">
                {guide.data.credit.name}
              </a>
            ) : (
              <strong>{guide.data.credit.name}</strong>
            )}
            {guide.data.youtube.length > 0 && ' — watch their original video below.'}
          </p>
        )
      }
      {guide.data.summary && <p class="guide-summary">{guide.data.summary}</p>}
    </header>

    {
      guide.data.youtube.length > 0 && (
        <section class="videos" aria-label="Video guides">
          {guide.data.youtube.map((url) => (
            <YouTubeEmbed url={url} title={`${guide.data.title} — video guide`} />
          ))}
        </section>
      )
    }

    <div class="guide-body">
      <Content />
    </div>

    <footer class="guide-footer">
      {
        isUnique ? (
          <p>
            A step wrong, or something changed after a patch?{' '}
            <a href={changeUrl}>Request a change to this guide.</a>
          </p>
        ) : (
          <p>
            <a href={changeUrl}>Request a change to this guide</a> — or{' '}
            <a href={submitBase}>submit your own {typeName.toLowerCase()} strategy.</a>
          </p>
        )
      }
    </footer>
  </article>
</Base>

<style>
  .guide-header {
    border-left: 4px solid var(--type-color, var(--line-strong));
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .guide-header h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    margin: 0.4rem 0 0.6rem;
  }

  .guide-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .tag {
    color: var(--ink-faint);
  }

  .guide-credit {
    font-size: 0.9rem;
    color: var(--ink-muted);
    margin: 0.7rem 0 0;
  }

  .guide-summary {
    max-width: var(--measure);
    color: var(--ink-muted);
    font-size: 1.02rem;
    margin: 0.8rem 0 0;
  }

  .videos {
    margin: 1.5rem 0;
  }

  .guide-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
</style>
